# Copie este arquivo para ".env" e preencha com os valores reais.
# O .env nunca deve ir pro Git (veja .gitignore) nem para o webroot público.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=doaaqui
DB_USER=doaaqui_app
DB_PASS=troque_esta_senha

APP_ENV=development
APP_DEBUG=true

SESSION_NAME=doaaqui_sessao

# Origem exata (protocolo + host + porta) de onde o front-end vai chamar a API.
# Deixe vazio para desabilitar CORS (front-end e API no mesmo domínio).
CORS_ALLOWED_ORIGIN=http://localhost:8080
